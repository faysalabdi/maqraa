EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local dev: http://localhost:3000 — production: https://www.maqraa.app
# Must be the exact host that serves /api/v1 without redirecting: a redirect to
# a different host is cross-origin, and fetch strips the Authorization header
# across those, so every authenticated call would silently 401.
EXPO_PUBLIC_API_URL=
# RevenueCat public iOS SDK key. Inlined at build time, so a production build
# without it ships with in-app purchases silently disabled — mirror it into the
# EAS environment before building, not just into this file.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
